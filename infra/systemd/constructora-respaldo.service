[Unit]
Description=Constructora · respaldo diario de la base con restic
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/constructora
ExecStart=/opt/constructora/respaldo.sh diario
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=2h
