# Copiar a /opt/constructora/.env con permisos 600. Nunca se sube al repositorio.
# Las contraseñas de PostgreSQL van en secrets/ (ver docs/runbooks/primer-arranque.md).

DOMINIO=preprod.constructora.mx
CORREO_ACME=sistemas@constructora.mx
IMAGEN=ghcr.io/ORGANIZACION/constructora
APP_ENTORNO=preproduccion
APP_MEMORIA=1500m
PG_SHARED_BUFFERS=768MB
PG_EFFECTIVE_CACHE=2GB
# Producción (4 vCPU, 8 GB): DOMINIO=sistema.constructora.mx, APP_ENTORNO=produccion,
# APP_MEMORIA=3g, PG_SHARED_BUFFERS=2GB, PG_EFFECTIVE_CACHE=5GB.

# Segundo factor (H7): obligatorio para administración y dirección. La llave cifra los secretos:
#   openssl rand -base64 32
# Una distinta por entorno, con copia en el gestor de contraseñas. Si se pierde, cada quien vuelve
# a dar de alta su segundo factor (docs/runbooks/segundo-factor.md).
APP_LLAVE_SEGUNDO_FACTOR=
APP_SEGUNDO_FACTOR_EMISOR=Constructora

# Contraseñas de la app y del migrador (las mismas que secrets/pg_app_password y pg_migrador_password)
DB_CONTRASENA=
DB_MIGRADOR_CONTRASENA=

# Solo el primer arranque: crea la empresa y su administrador. Después se borran estas líneas.
APP_INICIAL_EMPRESA=RM Alemán
APP_INICIAL_RFC=
APP_INICIAL_USUARIO=admin
APP_INICIAL_NOMBRE=Administración
APP_INICIAL_CONTRASENA=
