# Copiar a /opt/constructora/respaldo.env (permisos 600, dueño deploy). Nunca se sube al repositorio.
# Ver docs/runbooks/respaldos.md.

# Repositorio de restic en un bucket de OTRO proveedor (Backblaze B2 o Cloudflare R2), una carpeta
# por entorno. La llave de la aplicación de B2 solo tiene acceso a ese bucket.
RESTIC_REPOSITORY=s3:https://s3.us-west-004.backblazeb2.com/constructora-respaldos/produccion
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# La llave que cifra los respaldos. Copia en el gestor de contraseñas de la empresa: sin ella los
# respaldos no se pueden abrir (docs/runbooks/acceso-emergencia.md).
RESTIC_PASSWORD_FILE=/opt/constructora/secrets/restic_password
# Nombre con el que se guardan los respaldos; un servidor recreado usa el mismo.
RESTIC_HOST=constructora-prod

# Prueba mensual de restauración en una base temporal (solo producción).
RESTAURACION_MENSUAL=si

# Monitores de tipo push de Uptime Kuma (en preproducción, por Tailscale). Vacíos = sin aviso.
# El latido (vigilar.sh, cada 5 min) también avisa si la última prueba de restauración falló o si
# no hay una correcta en 36 días (docs/runbooks/monitoreo.md).
KUMA_RESPALDO=https://constructora-preprod.TAILNET.ts.net/api/push/TOKEN-RESPALDO
KUMA_VIGILAR=https://constructora-preprod.TAILNET.ts.net/api/push/TOKEN-VIGILAR
