{
  "openapi": "3.1.0",
  "info": {
    "title": "Sistema para constructora",
    "description": "API de inventario, costo y abastecimiento",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Sesión"
        ],
        "summary": "Iniciar sesión",
        "operationId": "iniciarSesion",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/yo": {
      "get": {
        "tags": [
          "Sesión"
        ],
        "summary": "Usuario en sesión",
        "operationId": "sesionActual",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SesionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/csrf": {
      "get": {
        "tags": [
          "Sesión"
        ],
        "summary": "Token CSRF",
        "operationId": "tokenCsrf",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Usuarios de la empresa",
        "operationId": "listarUsuarios",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UsuarioDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Dar de alta un usuario",
        "operationId": "crearUsuario",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudNuevoUsuario"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UsuarioDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/usuarios/roles": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "summary": "Roles disponibles y sus permisos",
        "operationId": "listarRoles",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogoRolDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/version": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "summary": "Versión y entorno",
        "operationId": "version",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "SolicitudLogin": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "string",
            "maxLength": 60,
            "minLength": 0
          },
          "contrasena": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          }
        },
        "required": [
          "contrasena",
          "usuario"
        ]
      },
      "RolDto": {
        "type": "object",
        "properties": {
          "clave": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          }
        },
        "required": [
          "clave",
          "nombre"
        ]
      },
      "SesionDto": {
        "type": "object",
        "properties": {
          "usuarioId": {
            "type": "integer",
            "format": "int64"
          },
          "usuario": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "empresaId": {
            "type": "integer",
            "format": "int64"
          },
          "empresa": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolDto"
            }
          },
          "permisos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "empresa",
          "empresaId",
          "nombre",
          "permisos",
          "roles",
          "usuario",
          "usuarioId"
        ]
      },
      "CsrfDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "encabezado": {
            "type": "string"
          }
        },
        "required": [
          "encabezado",
          "token"
        ]
      },
      "SolicitudNuevoUsuario": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "string",
            "pattern": "[A-Za-z0-9._-]{3,60}"
          },
          "nombre": {
            "type": "string",
            "maxLength": 120,
            "minLength": 0
          },
          "correo": {
            "type": "string",
            "format": "email",
            "maxLength": 120,
            "minLength": 0
          },
          "contrasena": {
            "type": "string",
            "maxLength": 200,
            "minLength": 10
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "contrasena",
          "nombre",
          "roles",
          "usuario"
        ]
      },
      "UsuarioDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "usuario": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "correo": {
            "type": "string"
          },
          "activo": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RolDto"
            }
          }
        },
        "required": [
          "activo",
          "id",
          "nombre",
          "roles",
          "usuario"
        ]
      },
      "CatalogoRolDto": {
        "type": "object",
        "properties": {
          "clave": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "permisos": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "clave",
          "nombre",
          "permisos"
        ]
      },
      "VersionDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "entorno": {
            "type": "string"
          }
        },
        "required": [
          "entorno",
          "version"
        ]
      }
    }
  }
}